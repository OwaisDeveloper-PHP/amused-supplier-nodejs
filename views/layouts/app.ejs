<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> — Amused Supplier Console</title>
    <link rel="icon" href="/Amused_logo.avif">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet">
</head>
<body>
<%
    const navActive = (prefix) => (prefix === '/' ? currentPath === '/' : currentPath.startsWith(prefix)) ? 'active' : '';
%>
<div class="shell">
    <aside class="sidebar">
        <div class="sidebar__logo">
            <img src="/Amused_logo.avif" alt="Amused">
            <div class="sidebar__tag">Supplier Console</div>
        </div>
        <nav class="nav">
            <div class="nav__label">Overview</div>
            <a href="/" class="<%= navActive('/') %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                Dashboard
            </a>
            <div class="nav__label">Consignment</div>
            <a href="/submissions" class="<%= navActive('/submissions') %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                Sell With Us Entries
            </a>
            <a href="/email-templates/1/edit" class="<%= navActive('/email-templates') %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                Email Templates
            </a>
            <div class="nav__label">Network</div>
            <a href="/suppliers" class="<%= navActive('/suppliers') %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 3 7v6c0 5 4 7 9 8 5-1 9-3 9-8V7l-9-4Z"/><path d="m9 12 2 2 4-4"/></svg>
                Suppliers
            </a>
        </nav>
        <div class="sidebar__foot">
            <div class="sidebar__user">
                <b><%= currentUser?.name ?? 'Admin' %></b>
                <%= currentUser?.email ?? '' %>
            </div>
            <form method="POST" action="/logout">
                <input type="hidden" name="_token" value="<%= csrfToken %>">
                <button class="btn btn--ghost btn--sm" style="width:100%;justify-content:center;">Sign out</button>
            </form>
        </div>
    </aside>

    <div class="main">
        <div class="topbar">
            <div>
                <div class="crumb"><%= typeof crumb !== 'undefined' ? crumb : 'Amused' %></div>
                <h1><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h1>
            </div>
            <div><%- topbarActions %></div>
        </div>
        <div class="content">
            <% if (status) { %>
                <div class="flash flash--ok">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 13 4 4L19 7"/></svg>
                    <%= status %>
                </div>
            <% } %>
            <% if (error) { %>
                <div class="flash flash--err"><%= error %></div>
            <% } %>
            <% if (errors && errors.length) { %>
                <div class="flash flash--err"><%= errors[0] %></div>
            <% } %>

            <%- content %>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('form[data-confirm]').forEach(f => {
        f.addEventListener('submit', e => { if (!confirm(f.dataset.confirm)) e.preventDefault(); });
    });
</script>
<%- scripts %>
</body>
</html>
