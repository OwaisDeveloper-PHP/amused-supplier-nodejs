APP_NAME="Amused Supplier Console"
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/amused_supplier?schema=public"

SESSION_SECRET=change-me-to-a-long-random-string

# SMTP (defaults to a local/log transport if unset — see src/services/mailer.ts)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=concierge@amusedco.com
MAIL_FROM_NAME=Amused

# hCaptcha secret used to verify "h-captcha-response" on the public Sell With Us API.
# Leave blank in local/dev environments to skip verification.
HCAPTCHA_SECRET=
